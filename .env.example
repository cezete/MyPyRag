# MyPyRag example configuration. Copy to .env; never commit secrets.
MYPYRAG_MAX_STAGE=INDEXED
MYPYRAG_UNIVERSE_MAX_DEPTH=8
MYPYRAG_UNIVERSE_MAX_LENGTH=128
MYPYRAG_UNIVERSE_SEGMENT_MAX_LENGTH=32
MYPYRAG_POLL_INTERVAL_SECONDS=10
MYPYRAG_FILE_STABLE_SECONDS=10
MYPYRAG_LOG_LEVEL=INFO
MYPYRAG_IN_DIR=docs/IN
MYPYRAG_DONE_DIR=docs/DONE
MYPYRAG_ERROR_DIR=docs/ERROR
MYPYRAG_DOCLING_JSON_FILENAME=document.json
MYPYRAG_CHUNKER=hybrid
MYPYRAG_CHUNK_MAX_TOKENS=512
MYPYRAG_CHUNK_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

# PostgreSQL is bound only to the database host's loopback interface. On Windows,
# first create an SSH tunnel that maps local port 5436 to Nagypapi's 127.0.0.1:5436.
MYPYRAG_POSTGRES_HOST=127.0.0.1
MYPYRAG_POSTGRES_PORT=5436
MYPYRAG_POSTGRES_DATABASE=mypyrag
MYPYRAG_POSTGRES_USER=mypyrag_app
MYPYRAG_POSTGRES_PASSWORD=
MYPYRAG_POSTGRES_SCHEMA=mypyrag
MYPYRAG_POSTGRES_SSLMODE=disable
MYPYRAG_POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Ollama embedding service
MYPYRAG_OLLAMA_URL=http://192.168.3.32:11434
MYPYRAG_EMBEDDING_MODEL=nomic-embed-text:latest
MYPYRAG_EMBEDDING_VECTOR_SIZE=768
MYPYRAG_EMBEDDING_MODEL_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
MYPYRAG_EMBEDDING_TIMEOUT_SECONDS=120
MYPYRAG_EMBEDDING_BATCH_SIZE=16

# Search
MYPYRAG_SEARCH_DEFAULT_LIMIT=5
MYPYRAG_SEARCH_MAX_LIMIT=50
